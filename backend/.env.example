DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aetheris_db
DB_USER=
DB_PASSWORD=

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=
# Login lifetime in seconds (default 3600 = 1 hour)
JWT_ACCESS_TOKEN_EXPIRES=3600

UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=52428800

# Optional
# HOST=127.0.0.1
# PORT=5000
# CORS_ORIGINS=http://localhost:5000
# FLASK_DEBUG=1

# Optional TURN relay for calls on strict networks
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
